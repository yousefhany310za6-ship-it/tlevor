{
  "name": "tlevor-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Tlevor Framework Monorepo",
  "scripts": {
    "build": "pnpm --filter \"@tlevor/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint packages examples",
    "publish:packages": "pnpm -r publish --access public",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "oxlint": "^1.77.0",
    "tsx": "^4.10.1",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
